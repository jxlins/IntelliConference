<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jxl.ai.intelliconf.dao.mapper.ConferenceMapper">

    <!-- 分页查询短链接 -->
    <select id="pageConference" parameterType="com.jxl.ai.intelliconf.dto.req.ConferencePageRepDTO"
            resultType="com.jxl.ai.intelliconf.dto.resp.ConferencePageRespDTO">
        SELECT c.title,
               c.short_name,
               c.start_time,
               c.end_time,
               c.current_state,
               c.setup_status,
               l.province,
               l.city,
               l.country,
               l.address
        FROM conferences c
        LEFT JOIN location l ON c.id = l.confer_id
        WHERE c.create_user = #{createUser} AND c.del_flag = 0
        ORDER BY c.end_time DESC
    </select>
</mapper>
